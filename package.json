    "axios": "^1.12.2",
    "babel-core": "7.0.0-bridge.0",
    "babel-eslint": "10.1.0",
    "babel-jest": "30.1.2",
    "babel-plugin-named-asset-import": "^0.3.8",
    "bfj": "9.1.2",
    "case-sensitive-paths-webpack-plugin": "2.4.0",
    "dotenv": "17.2.2",
    "dotenv-expand": "^12.0.3",
    "eslint-plugin-react": "^7.37.5",
    "fs-extra": "11.3.2",
    "html-webpack-plugin": "5.6.4",
    "identity-obj-proxy": "3.0.0",
    "jest": "30.1.3",
    "jest-pnp-resolver": "1.2.3",
    "jest-resolve": "30.1.3",
    "jest-watch-typeahead": "^3.0.1",
    "js-combinatorics": "^2.1.2",
    "json-loader": "^0.5.7",
    "mini-css-extract-plugin": "2.9.4",
    "pnp-webpack-plugin": "1.7.0",
    "postcss-flexbugs-fixes": "5.0.2",
    "postcss-preset-env": "10.3.1",
    "postcss-safe-parser": "7.0.1",
    "prop-types": "^15.8.1",
    "react": "^19.1.1",
    "react-app-polyfill": "^3.0.0",
    "react-dev-utils": "^12.0.1",
    "react-dom": "^19.1.1",
    "react-intl": "^7.1.11",
    "react-intl-locale": "^0.5.3",
    "react-test-renderer": "^19.1.1",
    "resolve": "1.22.10",
    "style-loader": "4.0.0",
    "terser-webpack-plugin": "5.3.14",
    "url": "^0.11.4",
    "uuid": "^13.0.0",
    "webpack-manifest-plugin": "5.0.1",
    "workbox-webpack-plugin": "7.3.0"
  },
  "scripts": {
    "start": "node scripts/start.js",
    "build": "node scripts/build.js",
    "test": "node scripts/test.js"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,ts,tsx}",
      "!src/**/*.d.ts"
    ],
    "resolver": "jest-pnp-resolver",
    "setupFiles": [
      "react-app-polyfill/jsdom"
    ],
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.{js,jsx,ts,tsx}",
      "<rootDir>/src/**/?(*.)(spec|test).{js,jsx,ts,tsx}"
    ],
    "testEnvironment": "jsdom",
    "testURL": "http://localhost",
    "transform": {
      "^.+\\.(js|jsx|ts|tsx)$": "<rootDir>/node_modules/babel-jest",
      "^.+\\.css$": "<rootDir>/config/jest/cssTransform.js",
      "^(?!.*\\.(js|jsx|ts|tsx|css|json)$)": "<rootDir>/config/jest/fileTransform.js"
    },
    "transformIgnorePatterns": [
      "[/\\\\]node_modules[/\\\\].+\\.(js|jsx|ts|tsx)$",
      "^.+\\.module\\.(css|sass|scss)$"
    ],
    "moduleNameMapper": {
      "^react-native$": "react-native-web",
      "^.+\\.module\\.(css|sass|scss)$": "identity-obj-proxy"
    },
    "moduleFileExtensions": [
      "web.js",
      "js",
      "web.ts",
      "ts",
      "web.tsx",
      "tsx",
      "json",
      "web.jsx",
      "jsx",
      "node"
    ],
    "watchPlugins": [
      "/Users/sergry/Documents/git/scrabble/node_modules/jest-watch-typeahead/filename.js",
      "/Users/sergry/Documents/git/scrabble/node_modules/jest-watch-typeahead/testname.js"
    ]
  },
  "babel": {
    "presets": [
      "react-app"
    ]
  },
  "devDependencies": {
    "@babel/cli": "^7.28.3",
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "babel-loader": "^10.0.0",
    "babel-preset-react-app": "^10.1.0",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.2",
    "eslint": "^8.57.1",
    "eslint-config-react-app": "^7.0.1",
    "eslint-webpack-plugin": "^5.0.2",
    "file-loader": "^6.2.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "postcss-loader": "^8.2.0",
    "sass-loader": "^16.0.5",
    "url-loader": "^4.1.1",
    "webpack": "^5.101.3",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  }
}
